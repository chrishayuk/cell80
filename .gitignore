# Rust build output (any workspace, incl. cellz_py / cell-bench sub-workspaces)
target/
Cargo.lock
**/*.rs.bk

# Python (cellz_py wheels, chuk-mcp-cell)
__pycache__/
*.py[cod]
*.egg-info/
*.whl
*.so
.venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
build/

.DS_Store
/testroms

# Fetched-on-demand correctness test data (the fetch.sh scripts stay tracked)
z80-tests/sst/v1/
z80-tests/zex/*.com
z80-tests/zex/*.cim

# generated dialect tapes (rustz80 speccy-compile output)
/*.tap

# video/production scripts (not part of the shipped project)
/docs/scripts/

# Experiment run products. Scripts put disposable data below their local
# artifacts/ directory; removing those directories resets all generated state.
/experiments/**/artifacts/

# Legacy experiment outputs, kept ignored while older local runs are migrated.
/experiments/**/*.log
/experiments/**/*.pt
/experiments/**/*.pth
/experiments/**/*.npy
/experiments/**/*.u32
/experiments/**/.venv*/

# Legacy locations for generated datasets/build products. Current scripts write
# these below artifacts/, but keep stale invocations from re-adding large blobs.
/experiments/cell-native-architectures/cn*_corpus_*.jsonl
/experiments/cell-native-architectures/cn1_synth_fingerprints.jsonl
/experiments/cell-native-architectures/v11-cells.vocab.bin
/experiments/corpus-atlas/harvest_catalogue_*.jsonl
/experiments/corpus-atlas/skeleton_vocab.json
